<?php
// Table columns are driven by the target-disk checkboxes in the form
// above (see the script below): the checked-state rendered by the form IS
// the saved selection, and ticking/unticking re-renders the table as a
// live preview.  No separate configured-device list is embedded — the
// checkbox DOM is the single source of truth for the column set.
?>
<div id="progress-wrap">
  <table id="progress-table"></table>
</div>
<script>
// Progress table: rows = statistics grouped by hierarchy, columns = the
// TARGETED disks (the checkboxes in the settings form above).  Polls
// status.php every 5 s; the response is blank-line-separated key=value
// blocks (final per-device blocks from the run log, then the live block,
// then meta), all parsed with the same tiny kv parser.
//
// The column set is STABLE: every array data disk (each checkbox) is a
// potential column, and the table always renders exactly the checked
// ones, in checkbox order (= discovery order = the order the saved
// DEVICES list stores them in, which is the scrub order).  Ticking or
// unticking a disk just re-renders with that column added or removed — a
// live preview; the selection itself persists the usual way (form POST on
// Save).  Data tracking is independent of the selection: `disks` holds
// per-device state for every known device, so hiding a column never
// discards its results and re-checking a disk shows whatever progress
// exists for it (the last run's final counters, or live progress).  A new
// run (run_log change, or idle -> running) resets the table's data.
(function () {
  var url = '/plugins/<?=htmlspecialchars($plugin)?>/status.php';
  var POLL_MS = 5000;

  // Per-disk state for every KNOWN device (each checkbox): { st, data }.
  // `data` is the latest status kv block (final counters from the run
  // log, or live counters while running); `st` is pending|active|done|
  // error|cancelled.
  var disks = {};
  var runLog = null;
  var running = false;

  // The known devices ARE the checkboxes — a single source of truth for
  // the form and the table columns (checkbox order = discovery order =
  // the alphabetical order the saved DEVICES list is stored in).
  function allDevices() {
    var boxes = document.querySelectorAll('input[name="devices[]"]');
    var out = [];
    for (var i = 0; i < boxes.length; i++) out.push(boxes[i].value);
    return out;
  }
  // The current target selection = the checked boxes (the live DOM state;
  // the same state the form POST persists on Save).
  function targetedDevices() {
    var boxes = document.querySelectorAll('input[name="devices[]"]');
    var out = [];
    for (var i = 0; i < boxes.length; i++) if (boxes[i].checked) out.push(boxes[i].value);
    return out;
  }

  function mkDisk(st) { return { st: st, data: {} }; }
  // New run: reset the DATA for every known device (columns are stable —
  // only the data layer resets; status blocks re-populate it as the run
  // progresses).
  function resetDisks() {
    var devs = allDevices();
    disks = {};
    for (var i = 0; i < devs.length; i++) disks[devs[i]] = mkDisk('pending');
  }
  resetDisks();

  // --- formatting -------------------------------------------------------
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function int(v) { return Number(v).toLocaleString('en-US'); }
  function bytes(v) {
    var n = Number(v);
    if (!isFinite(n) || n < 0) return '-';
    if (n < 1024) return n + ' B';
    var units = ['KiB', 'MiB', 'GiB', 'TiB'];
    for (var i = 0; i < units.length; i++) {
      n /= 1024;
      if (n < 1024 || i === units.length - 1) {
        return n.toFixed(n >= 100 ? 0 : 1) + ' ' + units[i];
      }
    }
  }

  // Row hierarchy: group rows order the statistics so related counters
  // sit together.  Only genuinely non-obvious diagnostic rows carry a
  // question-mark help popup (same pattern as the settings form) with a
  // short plain-language explanation of what the number means and whether
  // action is needed; obvious rows (progress, volume, recovery outcome)
  // and group headers are plain.  Every popup-bearing group sits in the
  // lower half of the table and sets `up: true` so its popups open
  // upward: downward popups there would be cut off at the container's
  // bottom edge (worst case: the Issues found popups, which hang over
  // the Recovery group when the Metadata group is hidden).
  //
  // Visibility: always-visible rows are the healthy-scrub signals where a
  // visible 0 is meaningful (Progress, Scrub volume, Sectors mismatch,
  // Sectors read error, Recovered, Failed).  Rows marked 'cond' (Sectors
  // stale, Sectors no csum, Skipped, CSUM-tree branches stale) and the
  // Metadata group (cond: true) are hidden for ALL disks until some disk
  // reports a non-zero value for the stat — they are edge-case
  // diagnostics, not part of the essential view, and a healthy all-zero
  // run shows only the essential rows.
  var GROUPS = [
    { name: 'Progress',
      rows: [ ['Progress', 'progress'] ] },
    { name: 'Scrub volume',
      rows: [
        ['Sectors checked', 'sectors_checked'],
        ['Sectors OK', 'sectors_ok'],
        ['Bytes checked', 'bytes_checked']
      ] },
    { name: 'Issues found',
      up: true,
      rows: [
        ['Sectors mismatch', 'sectors_mismatch'],
        ['Sectors stale', 'sectors_stale', "These blocks looked wrong at first, but turned out fine: the filesystem legitimately rewrote or deleted them while the scan was running. This is normal activity on a busy disk, not corruption. No action needed.", 'cond'],
        ['CSUM-tree branches stale', 'stale_csum_branches', "Parts of the filesystem's checksum bookkeeping were freed and reused while the scan ran, because files were written, rewritten or deleted. Expected on a live filesystem, not corruption. Those areas were simply not re-verified this run; rerun during a quiet period for full coverage.", 'cond'],
        ['Sectors no csum', 'sectors_no_csum', "These blocks are stored without a checksum, so there is nothing to compare against. Nothing is wrong with them, they just cannot be verified. Harmless and expected; no action needed.", 'cond'],
        ['Sectors read error', 'sectors_read_error', "The disk could not read this data back (an I/O error). This is a hardware problem, not corrupted data: the drive is struggling or failing. Check its SMART health, and if it is failing, replace the disk and let the array rebuild (resilver) it from parity. The scan skips these blocks and keeps checking the rest of the disk."]
      ] },
    { name: 'Metadata',
      cond: true,
      up: true,
      rows: [
        ['Metadata header errors', 'metadata_header_errors', "The filesystem's metadata map (the bookkeeping that records which files exist and where their data is stored) is damaged: the disk returns the bytes, but no copy passes the integrity check. This is corruption of the map itself (e.g. bit rot), not a hardware read problem, and it cannot be rebuilt from parity. The scan skips the affected areas but continues with the rest of the disk. Action: unmount the disk and repair the filesystem offline with btrfs check --repair."],
        ['Metadata mirror mismatches', 'metadata_mirror_mismatches', "btrfs keeps two copies of the metadata map. They disagree, but at least one copy is intact, so btrfs reads the good one and refreshes the bad one itself. Harmless, no action needed. A normal btrfs scrub reports this the same way."],
        ['Metadata read errors', 'metadata_read_errors', "The disk refused to return the metadata map bytes at all (an I/O error, the kind a failing drive produces). Hardware problem, not corruption. The scan skips those areas but keeps scrubbing the rest. Check the drive's SMART health, and if it is failing, replace the disk and let the array rebuild it from parity."]
      ] },
    { name: 'Recovery',
      up: true,
      rows: [
        ['Recovered', 'recovered'],
        ['Failed', 'failed'],
        ['Skipped', 'skipped', "Blocks deliberately left unrepaired: at repair time, the bookkeeping covering exactly those blocks could not be read, so Rotshield could not confirm they are still corrupt, and it never writes a guess. A small number is the safe, cautious outcome. If it grows, the disk is likely having read trouble (see the read-error rows).", 'cond']
      ] }
  ];

  // Non-zero values get a colored hint (red = needs attention, amber =
  // caution, green = good news).
  var RED   = { sectors_mismatch: 1, sectors_read_error: 1,
                metadata_header_errors: 1, metadata_read_errors: 1, failed: 1 };
  var AMBER = { metadata_mirror_mismatches: 1, skipped: 1 };
  var GREEN = { recovered: 1 };

  var CHIP = {
    pending:   '<span class="chip chip-pending">pending</span>',
    active:    '<span class="chip chip-active">running</span>',
    done:      '<span class="chip chip-done">done</span>',
    error:     '<span class="chip chip-error">error</span>',
    cancelled: '<span class="chip chip-cancelled">cancelled</span>'
  };

  // --- table rendering --------------------------------------------------
  function cellProgress(d) {
    var pct = Number(d.data.progress_pct);
    if (!isFinite(pct)) return '-';
    var color = d.st === 'done' ? '#28a745'
              : d.st === 'error' ? '#dc3545'
              : d.st === 'cancelled' ? '#6c757d' : '#f0ad4e';
    return '<div class="pbar"><div class="pfill" style="width:' +
      Math.min(100, Math.max(0, pct)).toFixed(1) + '%;background:' + color + '"></div></div>' +
      ' <span class="ppct">' + pct.toFixed(2) + '%</span>';
  }

  // One stat cell for a disk; null means "no data yet" (rendered as -).
  function cellFor(d, key) {
    if (key === 'progress') return cellProgress(d);
    if (key === 'recovered' || key === 'failed' || key === 'skipped') {
      // Plain scrub (no array): the counters are meaningless, show n/a
      // instead of zeros that would read like "nothing was recovered".
      if (d.data.recovery === '0') {
        return '<span class="muted" title="No array information available, so this disk cannot be rebuilt from parity and recovery counts are not shown">n/a</span>';
      }
    }
    if (d.data[key] === undefined) return null;
    var n = Number(d.data[key]);
    var cls = '';
    if (n > 0 && RED[key]) cls = ' style="color:#dc3545;font-weight:bold"';
    else if (n > 0 && AMBER[key]) cls = ' style="color:#b8860b;font-weight:bold"';
    else if (n > 0 && GREEN[key]) cls = ' style="color:#28a745;font-weight:bold"';
    var txt = (key === 'bytes_checked') ? bytes(d.data[key]) : int(d.data[key]);
    if (key === 'recovered' && n > 0 && Number(d.data.sectors_mismatch) > 0) {
      // Recovered is a sub-outcome of the mismatches found above: "3 of 5".
      var m = Number(d.data.sectors_mismatch).toLocaleString('en-US');
      txt += ' <span class="of" title="of the ' + m + ' confirmed mismatches (recovered + failed = mismatch)">of ' + m + '</span>';
    }
    return '<span' + cls + '>' + txt + '</span>';
  }

  // Help popup wrapper - the same question-mark pattern the settings form
  // uses: label + icon, hover/focus shows the plain-language tip.  `up`
  // opens the popup above the icon (help-up): every table popup lives in
  // the lower groups, where a downward popup would be cut off at the
  // scrollable container's bottom edge.
  function helpWrap(label, tip, up) {
    return '<span class="help-block" tabindex="0">' + label +
           '<i class="fa fa-question-circle"></i>' +
           '<span class="help-content' + (up ? ' help-up' : '') + '">' + tip +
           '</span></span>';
  }

  // Row/group visibility: `anyDisk(key)` is true when at least one disk
  // has reported a non-zero value for the stat.  Conditional rows and
  // groups (see GROUPS) render only then — otherwise the whole row (or
  // the whole group including its header) is omitted for every disk.
  // Visibility of conditional rows/groups is judged on the RENDERED
  // columns only: a hidden (untargeted) disk's non-zero diagnostics must
  // not make a group appear whose visible cells would all be em-dashes.
  function anyDisk(key) {
    var devs = targetedDevices();
    for (var i = 0; i < devs.length; i++) {
      var d = disks[devs[i]];
      if (!d) continue;
      var v = d.data[key];
      if (v !== undefined && Number(v) > 0) return true;
    }
    return false;
  }
  // A conditional group is visible iff any of its stats is non-zero on
  // some disk (e.g. the Metadata group appears only when there is
  // something to look at).
  function groupVisible(grp) {
    for (var r = 0; r < grp.rows.length; r++) {
      if (anyDisk(grp.rows[r][1])) return true;
    }
    return false;
  }

  function renderTable() {
    // Columns = the checked (targeted) disks, in checkbox order — the same
    // order the saved DEVICES list stores them in, which is the scrub
    // order.  Rendering is a pure function of the current selection and
    // data; untargeted disks simply get no column (their data stays in
    // `disks` and reappears if re-targeted).
    var devs = targetedDevices();
    var span = devs.length + 1;
    var html = '<thead><tr><th style="text-align:left">Statistic</th>';
    for (var i = 0; i < devs.length; i++) {
      var d = disks[devs[i]];
      var name = devs[i].split('/').pop() || devs[i];
      // Chip: real states always show; "pending" only makes sense while a
      // run is active (the disk is queued).  Idle + no data = no chip.
      var chip = d.st !== 'pending' ? CHIP[d.st] : (running ? CHIP.pending : '');
      html += '<th style="text-align:left"><span class="devname" title="' + esc(devs[i]) + '">' +
              esc(name) + '</span>' + chip + '</th>';
    }
    html += '</tr></thead>';
    // No disks targeted -> headers only: no columns, no stat rows.  The
    // body (groups + rows) appears once at least one disk is targeted.
    if (devs.length > 0) {
      html += '<tbody>';
      // Scrub-order row: numbers the targeted disks in the order they are
      // scrubbed (checkbox order == the saved DEVICES order, which is the
      // order scrub.sh runs them in; a hand-edited config.cfg order is
      // honored by the run but cannot be shown here because the page's
      // columns derive from the checkbox list).
      html += '<tr><td class="stat">Scrub order</td>';
      for (var oi = 0; oi < devs.length; oi++) html += '<td>' + (oi + 1) + '</td>';
      html += '</tr>';
    for (var g = 0; g < GROUPS.length; g++) {
      var grp = GROUPS[g];
      // Conditional group (Metadata): hide the header AND its rows for
      // every disk until some disk actually reports an issue.
      if (grp.cond && !groupVisible(grp)) continue;
      html += '<tr class="grp"><td colspan="' + span + '">' + esc(grp.name) + '</td></tr>';
      for (var r = 0; r < grp.rows.length; r++) {
        var label = grp.rows[r][0], key = grp.rows[r][1], tip = grp.rows[r][2];
        // Conditional row: hide it for ALL disks until some disk reports
        // a non-zero value (stale / no-csum / skipped are diagnostics,
        // not healthy-scrub signals).
        if (grp.rows[r][3] === 'cond' && !anyDisk(key)) continue;
        html += '<tr><td class="stat">' + (tip ? helpWrap(esc(label), tip, grp.up) : esc(label)) + '</td>';
        for (var i = 0; i < devs.length; i++) {
          var d = disks[devs[i]];
          var cell = cellFor(d, key);
          var colcls = d.st === 'active' ? ' class="col-active"'
                     : d.st === 'done' ? ' class="col-done"'
                     : d.st === 'cancelled' ? ' class="col-cancelled"' : '';
          html += '<td' + colcls + '>' + (cell === null ? '-' : cell) + '</td>';
        }
        html += '</tr>';
      }
    }
      html += '</tbody>';
    }
    document.getElementById('progress-table').innerHTML = html;
  }

  // --- polling ----------------------------------------------------------
  function parseBlocks(text) {
    // { finals: [kv...], live: kv|null, liveRaw: string|null, meta: kv } —
    // blocks with state=done/error/cancelled are final (from the run log),
    // any other state block is live.
    var finals = [], live = null, liveRaw = null, meta = {};
    var parts = (text || '').split(/\n\s*\n/);
    for (var i = 0; i < parts.length; i++) {
      var kv = {};
      var lines = parts[i].trim().split('\n');
      for (var j = 0; j < lines.length; j++) {
        var eq = lines[j].indexOf('=');
        if (eq > 0) kv[lines[j].slice(0, eq)] = lines[j].slice(eq + 1);
      }
      if (kv.running !== undefined) { meta = kv; }
      else if (kv.state === 'done' || kv.state === 'error' || kv.state === 'cancelled') { finals.push(kv); }
      else if (kv.state) { live = kv; liveRaw = parts[i].trim(); }
    }
    return { finals: finals, live: live, liveRaw: liveRaw, meta: meta };
  }

  function apply(text) {
    var p = parseBlocks(text);
    var meta = p.meta;

    // New run detected: run log file changed, or idle -> running.
    if (meta.run_log && meta.run_log !== runLog) { runLog = meta.run_log; resetDisks(); }
    else if (meta.running === '1' && !running) { resetDisks(); }
    running = meta.running === '1';

    // Final blocks first, live block last (live wins for the active disk).
    // Data is tracked for every KNOWN device (each checkbox), independent
    // of the selection — hidden disks keep their results.  A device that
    // is not one of the known disks (stray value in a log, device removed
    // from the array) is ignored: it can never create a column.
    for (var i = 0; i < p.finals.length; i++) {
      var f = p.finals[i];
      if (!f.device || !disks[f.device]) continue;
      disks[f.device].st = f.state === 'error' ? 'error'
                         : f.state === 'cancelled' ? 'cancelled' : 'done';
      disks[f.device].data = f;
    }
    if (p.live && p.live.device && disks[p.live.device]) {
      disks[p.live.device].st = 'active';
      disks[p.live.device].data = p.live;
    }
    // Status server down mid-run: the log's most
    // recent "scrubbing <dev>" line still tells us which disk is active.
    if (running && !p.live && meta.active_device && disks[meta.active_device]) {
      if (disks[meta.active_device].st === 'pending') disks[meta.active_device].st = 'active';
    }

    updateLine(meta);
    var stopBtn = document.getElementById('stop-btn');
    if (stopBtn) stopBtn.style.display = running ? '' : 'none';
    // Keep the hidden Stop-snapshot field fresh with the last live payload,
    // so a Stop POST can hand scrub.sh its own snapshot as a fallback.
    if (p.liveRaw) {
      var snap = document.getElementById('stop-snapshot');
      if (snap) snap.value = p.liveRaw;
    }
    renderTable();
  }

  function updateLine(meta) {
    var el = document.getElementById('scrub-line');
    if (running) {
      var active = '';
      var keys = Object.keys(disks);
      for (var i = 0; i < keys.length; i++) {
        if (disks[keys[i]].st === 'active') { active = keys[i]; break; }
      }
      el.innerHTML = '<span style="color:#c00">Running</span>' +
        (active ? ' (active disk: <code>' + esc(active) + '</code>)' : '');
    } else {
      var s = 'Idle';
      if (meta.run_outcome) s += ' (last run: ' + meta.run_outcome + ')';
      el.textContent = s;
    }
  }

  function poll() {
    fetch(url, { cache: 'no-store' })
      .then(function (r) { return r.text(); })
      .then(apply)
      .catch(function () { /* transient failure \u2014 keep the last table */ });
  }
  poll();
  setInterval(poll, POLL_MS);

  // Live column preview: ticking/unticking a target disk shows or hides
  // its table column immediately.  Pure rendering — the selection itself
  // still persists the usual way (form POST on Save), and no data is
  // touched: hidden disks keep their tracked results and reappear with
  // them when re-checked.
  document.getElementById('settings-form').addEventListener('change', function (ev) {
    if (ev.target && ev.target.name === 'devices[]') renderTable();
  });
})();
</script>

