<?php
/* Rotshield settings page
 * Served by emhttp. Lets the user pick the device/array partition, set a
 * schedule, and trigger a scrub on demand. The actual work is done by
 * scripts/scrub.sh (backgrounded) so the UI never blocks. "Run Scrub Now"
 * and the scheduled cron job both call `scrub.sh run`, so manual and
 * scheduled runs behave identically. The Status section shows a per-disk
 * progress table fed by status.php: live counters (polled every 5 s) for
 * the disk currently being scrubbed, exact final counters from the run log
 * for finished disks. Raw logs are no longer shown in the UI (they are
 * still written to /boot/config/plugins/rotshield/runs for
 * debugging).
 */
$plugin      = "rotshield";
$plugin_dir  = "/usr/local/emhttp/plugins/$plugin";
$config_dir  = "/boot/config/plugins/$plugin";
$config_file = "$config_dir/config.cfg";

// Validate a 5-field cron time spec (min hour day-of-month month day-of-week).
// Each field must be non-empty and contain only safe cron characters, so a
// malicious value can never become part of the cron.d command line.
function cron_expr_valid($expr) {
    $fields = preg_split('/\s+/', trim($expr ?? ''));
    if (count($fields) !== 5) return false;
    foreach ($fields as $f) {
        if ($f === '' || !preg_match('/^[0-9*,?\/\-]+$/', $f)) return false;
    }
    return true;
}

// Discover the array's btrfs data-disk partitions from /proc/nmdstat|mdstat
// BEFORE the first-use config is created: the default config must not
// hardcode a target.  /dev/nmd1p1 (the array partition) is NOT one of the
// discoverable options, so a hardcoded default made a phantom disk appear
// in the progress table on systems where that device doesn't exist.
// NOTE: use shell_exec(), NOT exec(). PHP's exec() returns only the LAST
// line of output, so with multiple data disks exec() would silently drop
// every disk except the final one (e.g. only /dev/sdc shows up). shell_exec()
// captures the full multi-line output, which we then split into an array.
$devices_raw = shell_exec("$plugin_dir/scripts/scrub.sh devices 2>/dev/null") ?: '';
$devices = array_filter(array_map('trim', explode("\n", trim($devices_raw))));
// Present (and therefore save) disks in alphabetical order — natural sort,
// so /dev/loop2 comes before /dev/loop10.  The config is the single source
// of truth for the scrub order (scrub.sh runs DEVICES verbatim), so the
// saved DEVICES list is deliberately stored alphabetically here.
usort($devices, 'strnatcmp');

// First use (no config yet): create an EMPTY default config — no target is
// preselected.  The user picks disks; until then the progress table stays
// empty (headers only) and scrubbing is skipped (the POST handler and
// scrub.sh run() both refuse to invent a target).
if (!is_file($config_file)) {
    @mkdir($config_dir, 0777, true);
    file_put_contents($config_file,
        "DEVICES=''\n" .
        "DEVICE=''\n" .
        "SCHEDULE='disabled'\nCRON=''\nRECOVER=1\nWRITE=0\nNO_FREEZE=0\nBATCH_MAX=\nBATCH_IDLE=\nSTATUS_PORT=9101\nEXTRA_OPTIONS=\n");
}
$config = parse_ini_file($config_file);

$message = "";
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    // devices[] is a multi-select; keep only entries that are real array
    // data-disk partitions, then store them ALPHABETICALLY — the config is
    // the single source of truth for the scrub order (scrub.sh runs DEVICES
    // verbatim), so the saved order is deliberately normalized here.  A
    // hand-edited config.cfg order is honored by the run as-is.
    // An EMPTY selection is saved as-is and never silently replaced with
    // the first disk: with no disks targeted, scrubbing is skipped until
    // the user picks at least one (see the Target disk(s) help).
    $sel = $_POST['devices'] ?? [];
    $sel = is_array($sel) ? $sel : [$sel];
    $sel = array_values(array_filter(array_map('trim', $sel), fn($d) => $d !== '' && in_array($d, $devices, true)));
    usort($sel, 'strnatcmp');
    $devices_csv = implode(' ', $sel);
    // A scrub can take days, so "daily" is intentionally NOT offered — it
    // would overlap its own previous run. Allowed presets: weekly, monthly,
    // or a fully custom 5-field cron expression.
    $allowed_schedules = ['disabled','weekly','monthly','custom'];
    $schedule = trim($_POST['schedule'] ?? 'disabled');
    $schedule = in_array($schedule, $allowed_schedules) ? $schedule : 'disabled';
    // Custom cron: a 5-field time spec (min hour day month weekday). Only
    // used when schedule=custom. Validated strictly to block injection.
    $cron = trim($_POST['cron'] ?? '');
    if ($schedule === 'custom') {
        if (!cron_expr_valid($cron)) {
            $cron = '';
            $schedule = 'disabled';
            $message = "Invalid custom cron expression — schedule left disabled.";
        }
    }
    $recover  = isset($_POST['recover'])  ? 1 : 0;
    $write    = isset($_POST['write'])    ? 1 : 0;
    $no_freeze= isset($_POST['no_freeze'])? 1 : 0;
    $batch_max= escapeshellarg(trim($_POST['batch_max']   ?? ''));
    $batch_idle=escapeshellarg(trim($_POST['batch_idle']  ?? ''));
    $extra    = escapeshellarg(trim($_POST['extra_options'] ?? ''));
    // Live status port: 0 disables the localhost status endpoint, 1-65535
    // enables it on 127.0.0.1. Validated to a plain integer so it can never
    // inject anything into the config / command line.
    $status_port = trim($_POST['status_port'] ?? '9101');
    $status_port = (ctype_digit($status_port) && (int)$status_port <= 65535)
        ? (int)$status_port : 9101;
    // Single-quote every string value so the file is valid BOTH as PHP INI
    // (parse_ini_file strips the quotes) AND as a bash `source`d file. An
    // unquoted space-separated value — DEVICES with multiple disks, or a
    // 5-field CRON expression — would otherwise be executed as commands when
    // scrub.sh / rc.<plugin> source it, silently dropping the setting.
    file_put_contents($config_file,
        "DEVICES='$devices_csv'\n" .
        "DEVICE='" . ($sel[0] ?? '') . "'\n" .
        "SCHEDULE='$schedule'\n" .
        "CRON='$cron'\n" .
        "RECOVER=$recover\n" .
        "WRITE=$write\n" .
        "NO_FREEZE=$no_freeze\n" .
        "BATCH_MAX=$batch_max\n" .
        "BATCH_IDLE=$batch_idle\n" .
        "STATUS_PORT=$status_port\n" .
        "EXTRA_OPTIONS=$extra\n");
    exec("/etc/rc.d/rc.$plugin restart 2>&1");
    if (isset($_POST['run'])) {
        if ($devices_csv === '') {
            // Honest no-op: the empty selection was saved as-is above and
            // must never silently scrub something else.
            $message = "No disks targeted — nothing to scrub. Select at least one disk, then run again.";
        } else {
            exec("nohup $plugin_dir/scripts/scrub.sh run >/dev/null 2>&1 &");
            $message = "Scrub started in the background.";
        }
    } elseif (isset($_POST['stop'])) {
        // Pass the page's last-known live payload to scrub.sh stop() as a
        // fallback snapshot: if the status server can't be reached at stop
        // time (busy port, dead server, ...), the cancelled block still
        // carries the last numbers the page had.  stop() validates the
        // payload (device must match the active disk) before recording it.
        $snapshot = trim($_POST['last_status'] ?? '');
        $snapshot_file = '';
        if ($snapshot !== '') {
            $snapshot_file = "/tmp/${plugin}-stop-snapshot";
            @file_put_contents($snapshot_file, $snapshot);
        }
        // Surface the real outcome (e.g. "Run already finished") instead of
        // always claiming the stop was requested.
        $stop_out = trim(shell_exec("$plugin_dir/scripts/scrub.sh stop " . escapeshellarg($snapshot_file) . " 2>&1") ?: '');
        if ($snapshot_file !== '') { @unlink($snapshot_file); }
        $message = $stop_out !== '' ? $stop_out : "Scrub stop requested.";
    } else {
        $message = "Settings saved.";
    }
    $config = parse_ini_file($config_file);
}

// Live running state, derived purely from the run lock (process check) so it
// reflects BOTH manual and scheduled runs — no status-file bookkeeping.
$running = trim(shell_exec("$plugin_dir/scripts/scrub.sh running 2>/dev/null")) === '1';
?>
<h1 style="margin:0 0 12px">Rotshield</h1>
<?php if ($message): ?><div class="notice"><?=htmlspecialchars($message)?></div><?php endif; ?>

<style>
