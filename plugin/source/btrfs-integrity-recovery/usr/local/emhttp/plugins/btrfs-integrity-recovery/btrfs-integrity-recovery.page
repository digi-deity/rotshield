Menu="Utilities"
Title="btrfs-integrity-recovery"
Icon="btrfs-integrity-recovery.png"
---
<?php
/* btrfs-integrity-recovery settings page
 * Served by emhttp. Lets the user pick the device/array partition, set a
 * schedule, trigger a scrub on demand, and view per-run logs. The actual
 * work is done by scripts/scrub.sh (backgrounded) so the UI never blocks.
 * "Run Scrub Now" and the scheduled cron job both call `scrub.sh run`, so
 * manual and scheduled runs are logged identically and appear the same way
 * in the View Logs panel.
 */
$plugin      = "btrfs-integrity-recovery";
$plugin_dir  = "/usr/local/emhttp/plugins/$plugin";
$config_dir  = "/boot/config/plugins/$plugin";
$config_file = "$config_dir/config.cfg";
$runs_dir    = "$config_dir/runs";

// Validate a 5-field cron time spec (min hour day-of-month month day-of-week).
// Each field must be non-empty and contain only safe cron characters, so a
// malicious value can never become part of the cron.d command line.
function cron_expr_valid($expr) {
    $fields = preg_split('/\s+/', trim($expr ?? ''));
    if (count($fields) !== 5) return false;
    foreach ($fields as $f) {
        if ($f === '' || !preg_match('/^[0-9*,?\/\-]+$/', $f)) return false;
    }
    return true;
}

if (!is_file($config_file)) {
    @mkdir($config_dir, 0777, true);
    file_put_contents($config_file, "DEVICES='/dev/nmd1p1'\nDEVICE='/dev/nmd1p1'\nSCHEDULE='disabled'\nCRON=''\nRECOVER=1\nWRITE=0\nNO_FREEZE=0\nBATCH_MAX=\nBATCH_IDLE=\nEXTRA_OPTIONS=\n");
}
$config = parse_ini_file($config_file);

// Discover the array's btrfs data-disk partitions from /proc/nmdstat|mdstat.
// NOTE: use shell_exec(), NOT exec(). PHP's exec() returns only the LAST
// line of output, so with multiple data disks exec() would silently drop
// every disk except the final one (e.g. only /dev/sdc shows up). shell_exec()
// captures the full multi-line output, which we then split into an array.
$devices_raw = shell_exec("$plugin_dir/scripts/scrub.sh devices 2>/dev/null") ?: '';
$devices = array_filter(array_map('trim', explode("\n", trim($devices_raw))));
if (empty($devices)) {
    $devices = ['/dev/nmd1p1'];   // fallback if the array isn't up yet
}

$message = "";
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    // devices[] is a multi-select; keep only entries that are real array
    // data-disk partitions, in the order presented.
    $sel = $_POST['devices'] ?? [];
    $sel = is_array($sel) ? $sel : [$sel];
    $sel = array_values(array_filter(array_map('trim', $sel), fn($d) => in_array($d, $devices, true)));
    if (empty($sel)) { $sel = [$devices[0]]; }
    $devices_csv = implode(' ', $sel);
    // A scrub can take days, so "daily" is intentionally NOT offered — it
    // would overlap its own previous run. Allowed presets: weekly, monthly,
    // or a fully custom 5-field cron expression.
    $allowed_schedules = ['disabled','weekly','monthly','custom'];
    $schedule = trim($_POST['schedule'] ?? 'disabled');
    $schedule = in_array($schedule, $allowed_schedules) ? $schedule : 'disabled';
    // Custom cron: a 5-field time spec (min hour day month weekday). Only
    // used when schedule=custom. Validated strictly to block injection.
    $cron = trim($_POST['cron'] ?? '');
    if ($schedule === 'custom') {
        if (!cron_expr_valid($cron)) {
            $cron = '';
            $schedule = 'disabled';
            $message = "Invalid custom cron expression — schedule left disabled.";
        }
    }
    $recover  = isset($_POST['recover'])  ? 1 : 0;
    $write    = isset($_POST['write'])    ? 1 : 0;
    $no_freeze= isset($_POST['no_freeze'])? 1 : 0;
    $batch_max= escapeshellarg(trim($_POST['batch_max']   ?? ''));
    $batch_idle=escapeshellarg(trim($_POST['batch_idle']  ?? ''));
    $extra    = escapeshellarg(trim($_POST['extra_options'] ?? ''));
    // Single-quote every string value so the file is valid BOTH as PHP INI
    // (parse_ini_file strips the quotes) AND as a bash `source`d file. An
    // unquoted space-separated value — DEVICES with multiple disks, or a
    // 5-field CRON expression — would otherwise be executed as commands when
    // scrub.sh / rc.<plugin> source it, silently dropping the setting.
    file_put_contents($config_file,
        "DEVICES='$devices_csv'\n" .
        "DEVICE='{$sel[0]}'\n" .
        "SCHEDULE='$schedule'\n" .
        "CRON='$cron'\n" .
        "RECOVER=$recover\n" .
        "WRITE=$write\n" .
        "NO_FREEZE=$no_freeze\n" .
        "BATCH_MAX=$batch_max\n" .
        "BATCH_IDLE=$batch_idle\n" .
        "EXTRA_OPTIONS=$extra\n");
    exec("/etc/rc.d/rc.$plugin restart 2>&1");
    if (isset($_POST['run'])) {
        exec("nohup $plugin_dir/scripts/scrub.sh run >/dev/null 2>&1 &");
        $message = "Scrub started in the background.";
    } elseif (isset($_POST['stop'])) {
        exec("$plugin_dir/scripts/scrub.sh stop 2>&1");
        $message = "Scrub stop requested.";
    } else {
        $message = "Settings saved.";
    }
    $config = parse_ini_file($config_file);
}

// View Logs: ?view=1 shows the latest run's log; ?log=<file> shows a specific
// historical run. Both manual and scheduled runs are listed here.
$view_log = "";
$view_title = "Latest run log";
if (isset($_GET['log'])) {
    $want = basename($_GET['log']);                 // guard against path traversal
    $candidate = "$runs_dir/$want";
    if (is_file($candidate)) { $view_log = file_get_contents($candidate); $view_title = "Log: $want"; }
} elseif (isset($_GET['view'])) {
    // Latest run = most recently modified run-*.log (same rotation as the
    // history dropdown). Shown verbatim, no parsing or special handling.
    $latest = '';
    $candidates = glob("$runs_dir/run-*.log") ?: [];
    if ($candidates) {
        usort($candidates, fn($a, $b) => filemtime($b) <=> filemtime($a));
        $latest = $candidates[0];
    }
    if ($latest && is_file($latest)) { $view_log = file_get_contents($latest); $view_title = "Latest run log"; }
}

// Build the list of past run logs (newest first) for the history dropdown.
$run_logs = [];
if (is_dir($runs_dir)) {
    foreach (glob("$runs_dir/run-*.log") ?: [] as $f) {
        $run_logs[basename($f)] = filemtime($f);
    }
    arsort($run_logs);
    $run_logs = array_keys($run_logs);
}

// Live running state, derived purely from the run lock (process check) so it
// reflects BOTH manual and scheduled runs — no status-file bookkeeping.
$running = trim(shell_exec("$plugin_dir/scripts/scrub.sh running 2>/dev/null")) === '1';
?>
<h1 style="margin:0 0 12px">btrfs Integrity Recovery</h1>
<?php if ($message): ?><div class="notice"><?=htmlspecialchars($message)?></div><?php endif; ?>

<style>
/* Keep the settings form and log view within the page width; long log lines
   scroll inside the log block instead of widening the whole page. The label
   column stays a modest fixed width so inputs align right next to their
   pre-text instead of being pushed far right on wide screens. */
table.settings { max-width: 100%; }
table.settings td { overflow-wrap: break-word; word-wrap: break-word; vertical-align: top; }
table.settings td:first-child { width: 260px; padding-right: 12px; }
pre { max-width: 100%; overflow-x: auto; }
.help-block { position: relative; display: inline-block; }
.help-block .fa-question-circle { cursor: help; color: #6c757d; margin-left: 6px; vertical-align: middle; }
.help-block .help-content {
  display: none;
  position: absolute;
  left: 0;
  top: 1.5em;
  z-index: 200;
  width: 380px;
  max-width: 85vw;
  padding: 10px 12px;
  background: #fffef5;
  border: 1px solid #d6c98b;
  border-radius: 4px;
  box-shadow: 0 3px 10px rgba(0,0,0,.18);
  font-weight: normal;
  font-size: 12px;
  line-height: 1.45;
  color: #333;
  text-align: left;
  white-space: normal;
}
.help-block:hover .help-content,
.help-block:focus-within .help-content { display: block; }
</style>

<form method="post">
  <table class="settings">
    <tr><td>Schedule <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">How often an automatic scrub runs. <b>Disabled</b> = manual only; <b>Weekly</b> = Sundays 03:00; <b>Monthly</b> = 1st of month 03:00; <b>Custom</b> = your own 5-field cron. Daily is deliberately omitted because a full scrub can take days and would overlap its own previous run. The schedule is written to /etc/cron.d by the plugin's rc script; "Run Scrub Now" always works regardless of this setting.</span></span></td>
        <td><select name="schedule">
            <option value="disabled" <?=($config['SCHEDULE'] ?? 'disabled') === 'disabled' ? 'selected' : ''?>>Disabled</option>
            <option value="weekly"   <?=($config['SCHEDULE'] ?? '') === 'weekly'   ? 'selected' : ''?>>Weekly (Sun 03:00)</option>
            <option value="monthly"  <?=($config['SCHEDULE'] ?? '') === 'monthly'  ? 'selected' : ''?>>Monthly (1st 03:00)</option>
            <option value="custom"   <?=($config['SCHEDULE'] ?? '') === 'custom'   ? 'selected' : ''?>>Custom cron</option>
          </select>
</td></tr>
    <tr id="cron-row" style="<?=($config['SCHEDULE'] ?? 'disabled') === 'custom' ? '' : 'display:none'?>"><td>Custom cron <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">5-field cron time spec (minute hour day-of-month month day-of-week), used only when Schedule = Custom cron — e.g. <code>0 4 1 * *</code> runs at 04:00 on the 1st of each month. The value is strictly validated (only digits and *, ?, /, ,, - allowed) before saving, so an invalid entry is rejected and the schedule left disabled rather than injected. Leave blank to disable the custom schedule.</span></span></td>
        <td><input type="text" name="cron" size="22" value="<?=htmlspecialchars($config['CRON'] ?? '')?>" placeholder="0 4 1 * *">
</td></tr>
  <script>
  document.querySelector('select[name="schedule"]').addEventListener('change', function () {
      document.getElementById('cron-row').style.display = (this.value === 'custom') ? '' : 'none';
  });
  </script>
    <tr><td>Target disk(s) <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">Raw array data-disk partitions to scrub, auto-discovered from /proc/nmdstat (parity disks are excluded). Multiple disks are scrubbed sequentially, each with its own log. The partition offset is applied automatically per device, so you just pick the array data disk (e.g. /dev/nmd1p1 or /dev/sdX). Corruption is rare on a healthy array, so one disk is usually enough; add more only to cover several disks in a single scheduled job.</span></span></td>
        <td><div class="devices-list">
            <?php
            $selected = explode(' ', $config['DEVICES'] ?? ($config['DEVICE'] ?? '/dev/nmd1p1'));
            foreach ($devices as $d): ?>
            <label style="display:block"><input type="checkbox" name="devices[]" value="<?=htmlspecialchars($d)?>" <?=in_array($d, $selected, true) ? 'checked' : ''?>><?=htmlspecialchars($d)?></label>
            <?php endforeach; ?>
          </div>
</td></tr>
    <tr><td>Repair disk <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">Writes reconstructed blocks back to the disk (scrub-rs --repair). By default the tool runs in SAFE dry-run mode: it still reads every checksum, flags mismatches, and rebuilds the correct data from parity to tell you whether the corruption is recoverable — but it never touches the disk. Tick this only when you actually want the recovered blocks written back. The batch and freeze settings below only take effect in this repair mode; in the default dry-run they do nothing.</span></span></td>
        <td><label><input type="checkbox" name="write" value="1" <?=($config['WRITE'] ?? 0) ? 'checked' : ''?>> write reconstructed blocks back (--repair; default is dry-run assessment only)</label>
</td></tr>
    <tr><td>Disable freeze <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">Controls the filesystem freeze that makes repair writes safe. When Repair disk is enabled and the target is a live mounted filesystem, scrub-rs freezes the mount (FIFREEZE) around each recovery batch so the live FS cannot alter a block between re-confirmation and write-back, then thaws it. This is ON by default and only engages during repair on a mounted FS; unmounted images are never frozen. Only tick Disable freeze if the disk is not mounted/active — leaving it disabled during a live repair is unsafe. No effect in dry-run mode.</span></span></td>
        <td><label><input type="checkbox" name="no_freeze" value="1" <?=($config['NO_FREEZE'] ?? 0) ? 'checked' : ''?>> --no-freeze (unsafe with write on a live FS)</label>
</td></tr>
    <tr><td>Batch max <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">Max corruption candidates gathered into one recovery batch before it is written (scrub-rs --batch-max, default 64). Batching means one freeze/thaw cycle per burst instead of one per sector, and re-confirmation is deferred to write time so only still-corrupt blocks get written. Because corruption is rare on a healthy array, this rarely matters — it only becomes relevant under serious corruption during a repair run. Leave at the default unless you have a specific throughput reason to change it.</span></span></td>
        <td><input type="text" name="batch_max" size="10" value="<?=htmlspecialchars($config['BATCH_MAX'] ?? '')?>" placeholder="64">
</td></tr>
    <tr><td>Batch idle (s) <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">Idle seconds to wait before flushing a partially-filled recovery batch (scrub-rs --batch-idle, default 5.0). Guarantees a single isolated corruption still flushes promptly instead of waiting for the batch to fill. Like Batch max, this applies only during repair mode and is inconsequential for the usual rare, isolated corruption. Leave at the default in almost all cases.</span></span></td>
        <td><input type="text" name="batch_idle" size="10" value="<?=htmlspecialchars($config['BATCH_IDLE'] ?? '')?>" placeholder="5.0">
</td></tr>
    <tr><td>Extra options <span class="help-block" tabindex="0"><i class="fa fa-question-circle"></i><span class="help-content">Advanced: extra arguments appended verbatim to the scrub-rs command line (e.g. --dump-array or --resolve for debugging). Anything you type is passed through unmodified, so invalid flags will make the scrub fail with a usage error. Most users should leave this empty.</span></span></td>
        <td><input type="text" name="extra_options" size="40" value="<?=htmlspecialchars($config['EXTRA_OPTIONS'] ?? '')?>">
</td></tr>
  </table>
  <p>
    <input type="submit" name="save" value="Save Settings">
    <input type="submit" name="run"  value="Run Scrub Now">
    <input type="submit" name="stop" value="Stop Scrub" <?= $running ? '' : 'style="display:none"' ?>>
    <a class="button localURL" href="?plugin=<?=htmlspecialchars($plugin)?>&view=1">View Logs</a>
  </p>
</form>

<h2>Status</h2>
<p><b>Scrub:</b> <?= $running ? '<span style="color:#c00">Running</span>' : 'Idle' ?></p>

<?php if ($view_log !== "" || isset($_GET['view']) || isset($_GET['log'])): ?>
<h2><?=htmlspecialchars($view_title)?></h2>
<?php if ($run_logs): ?>
<form method="get" style="margin-bottom:8px">
  <input type="hidden" name="plugin" value="<?=htmlspecialchars($plugin)?>">
  <label>History:
    <select name="log" onchange="this.form.submit()">
      <option value="">— latest —</option>
      <?php foreach ($run_logs as $rl): ?>
      <option value="<?=htmlspecialchars($rl)?>" <?=(isset($_GET['log']) && $_GET['log'] === $rl) ? 'selected' : ''?>><?=htmlspecialchars($rl)?></option>
      <?php endforeach; ?>
    </select>
  </label>
</form>
<?php endif; ?>
<pre><?=htmlspecialchars($view_log !== "" ? $view_log : "(no log yet)")?></pre>
<?php endif; ?>
